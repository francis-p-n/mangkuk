# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Pick the backend you run with:

# Google Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
# SDOC_GEMINI_MODEL=gemini-3.6-flash

# Anthropic (console.anthropic.com)
# ANTHROPIC_API_KEY=

# SDOC_MODEL=claude-opus-5

# Supabase (Project Settings -> API)
#
# Supabase renamed both keys. A project issues either the old pair or the new
# one, never both, and the code reads whichever is set:
#
#   write key   SUPABASE_SERVICE_KEY   or  SUPABASE_SECRET_KEY
#   browser key ...ANON_KEY            or  ...PUBLISHABLE_KEY
#
# The write key bypasses row-level security and is the pipeline's alone. It
# must never reach the browser - only NEXT_PUBLIC_* vars do.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# The same project, as the web app reads it. Read-only by policy, so this one
# is meant to be public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
