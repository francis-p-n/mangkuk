# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Pick the backend you run with:

# Google Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
# SDOC_GEMINI_MODEL=gemini-3.6-flash

# Anthropic (console.anthropic.com)
# ANTHROPIC_API_KEY=

# SDOC_MODEL=claude-opus-5

# Supabase (Project Settings -> API)
# The service key bypasses row-level security and is the pipeline's write key.
# It must never reach the browser - only NEXT_PUBLIC_* vars do.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# The same project, as the web app reads it. Anon key is read-only by policy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
