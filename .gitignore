.tools/
# Everything the pipeline writes. Vercel builds the site from web/ now, so
# nothing under here needs to be committed - and a build artefact in git goes
# stale the moment the app moves on without it.
out/
__pycache__/
*.pyc
.pytest_cache/
.env
.env.local
web/node_modules/
web/.next/
web/out/
web/*.tsbuildinfo

# Generated by tools/thread_demo.py, not authored.
data/thread-demo/
