.tools/
# Everything the pipeline writes stays out of the repo, except the scrambled
# site: Vercel serves it from here with Root Directory set to out/site-demo,
# which is what keeps requirements.txt out of scope and stops Vercel reading
# the project as a Python app. out/site - the real bundle - stays ignored.
out/*
!out/site-demo/
__pycache__/
*.pyc
.pytest_cache/
.env
.env.local
web/node_modules/
web/.next/
web/out/
web/*.tsbuildinfo
